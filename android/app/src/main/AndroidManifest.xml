<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Odczyt historii użycia aplikacji. To uprawnienie specjalne:
         użytkownik włącza je ręcznie w Ustawienia > Dostęp do danych o użyciu,
         nie da się o nie poprosić dialogiem. `tools:ignore` jest konieczne,
         bo lint traktuje je jak uprawnienie systemowe. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Zamiana nazwy pakietu na czytelną nazwę aplikacji.
         UWAGA: to uprawnienie blokuje publikację w Google Play bez
         osobnego uzasadnienia. Dla prywatnego builda instalowanego przez
         `flutter install` nie ma znaczenia; przed ewentualną publikacją
         usuń tę linijkę — nazwy zdegradują się wtedy do nazw pakietów,
         a klasyfikacja i tak działa na nich, nie na etykietach. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Pod przyszłą synchronizację z Supabase oraz pobieranie aktualizacji. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Powiadomienia z przypomnieniami. Od Androida 13 wymagają zgody,
         o którą aplikacja prosi przy pierwszym włączeniu przypomnienia. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Przeplanowanie przypomnień po restarcie telefonu.
         Android kasuje wszystkie zaplanowane alarmy przy ponownym
         uruchomieniu — bez tego przypomnienia po cichu przestałyby
         przychodzić po pierwszym restarcie. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Nagrywanie głosu do dziennika umiejętności.
         Zgody prosi sama biblioteka `record` w momencie pierwszego
         nagrania, więc nie ma tu osobnego pakietu do uprawnień. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Robienie zdjęć i wideo bezpośrednio z poziomu wpisu.
         Wybieranie z galerii od Androida 13 idzie przez systemowy
         selektor zdjęć i nie wymaga żadnego uprawnienia. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Instalowanie aktualizacji pobranych spoza sklepu.
         Zgody i tak udziela użytkownik osobno („Instalowanie nieznanych
         aplikacji"), a systemowy ekran instalatora pojawia się zawsze —
         cichej instalacji nie da się tu zrobić i nie o to chodzi. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="Tempo"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Wyświetla powiadomienie w momencie zadziałania alarmu. -->
        <receiver
            android:name=".ReminderReceiver"
            android:exported="false" />

        <!-- Odtwarza zaplanowane przypomnienia po restarcie telefonu
             i po aktualizacji aplikacji. Android kasuje w obu tych
             sytuacjach wszystkie alarmy — bez tego odbiornika
             przypomnienia po cichu przestałyby przychodzić. -->
        <receiver
            android:name=".ReminderBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Udostępnia pobrany plik APK systemowemu instalatorowi.
             Od Androida 7 nie wolno przekazać innej aplikacji adresu
             `file://` — musi to być `content://` wystawione przez
             FileProvider, inaczej leci FileUriExposedException. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
